{
  "info": {
    "name": "Showtimes API (JWT)",
    "description": "Flujo: Register → Login (guarda {{token}} y {{usuarioId}}) → rutas protegidas con Bearer Token. Para crear películas/críticos entra con una cuenta admin (UPDATE usuarios SET rol='admin' ...).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "peliculaId",
      "value": "1"
    },
    {
      "key": "resenaId",
      "value": ""
    },
    {
      "key": "comentarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth (flujo de la presentación)",
      "item": [
        {
          "name": "1) Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"email\": \"ana@correo.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }",
                  "pm.test('Responde con token', () => pm.expect(j.token).to.be.a('string'));",
                  "if (j.usuario) { pm.collectionVariables.set('usuarioId', j.usuario.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2) Login (guarda {{token}})",
